{
  "name": "rotor-trails",
  "private": true,
  "version": "1.0.0",
  "description": "Rotor Trails（旋翼航迹）：第一人称拟真直升机闯关网页游戏",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "mapviz": "vitest run --config vitest.tools.config.ts tools/mapviz.tool.ts",
    "regress": "vitest run --config vitest.tools.config.ts tools/regression.tool.ts",
    "regress:recovery": "vitest run --config vitest.tools.config.ts tools/recovery-regression.tool.ts",
    "shots": "node tools/shot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
