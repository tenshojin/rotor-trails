{
  "url": "http://localhost:5174/?map=japan&autostart=1&weather=clear",
  "width": 1600,
  "height": 900,
  "steps": [
    {
      "until": "window.__app && window.__app.state === 'playing' && window.__app.view.cockpit.loaded",
      "timeout": 120000
    },
    {
      "eval": "(() => { document.querySelectorAll('.hud, #hud, .hud-root').forEach(e => e.style.display = 'none'); window.__app.debugTeleport(-640, 70, 700, 330, 30); window.__app.debugLook(0, -0.14); return 1; })()"
    },
    {
      "wait": 3000
    },
    {
      "shot": "c1_forward.jpg"
    },
    {
      "eval": "(() => { window.__app.debugLook(-0.12, -0.52); return 1; })()"
    },
    {
      "wait": 1500
    },
    {
      "shot": "c2_panel.jpg"
    },
    {
      "eval": "(() => { window.__app.debugLook(1.25, -0.25); return 1; })()"
    },
    {
      "wait": 1500
    },
    {
      "shot": "c3_left.jpg"
    },
    {
      "eval": "(() => { window.__app.debugLook(-1.3, -0.3); return 1; })()"
    },
    {
      "wait": 1500
    },
    {
      "shot": "c4_right.jpg"
    },
    {
      "eval": "(() => { window.__app.debugTeleport(-640, 70, 700, 150, 30); window.__app.debugLook(-0.12, -0.45); return 1; })()"
    },
    {
      "wait": 2500
    },
    {
      "shot": "c5_sun_behind.jpg"
    }
  ]
}